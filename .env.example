SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=safecurecs_dsr_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

MAX_PROFILE_PHOTO_SIZE_MB=2
MAX_DSR_ATTACHMENT_SIZE_MB=5

# --- Security hardening (safe defaults below are for LOCAL DEV only) ---
# In production, behind HTTPS, set all of these to True:
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# In production, once HTTPS is confirmed working end-to-end, set a real
# value (e.g. 31536000 = 1 year) and the two subdomain/preload flags:
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Session lifetime in seconds. 36000 = 10 hours, rolling (extends on activity).
SESSION_COOKIE_AGE=36000

# Logging verbosity. Use WARNING in production to cut routine noise;
# INFO (default) is appropriate for local development.
DJANGO_LOG_LEVEL=INFO
